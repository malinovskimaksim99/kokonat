// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

// 🏛️ PROJECT (Root Entity)
model Project {
  id          String   @id @default(uuid())
  title       String
  description String?
  content     String?  @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  chapters    Chapter[]
  lorebook    LorebookEntry[]
  graphNodes  GraphNode[]
  graphEdges  GraphEdge[]
}

// ✍️ CHAPTERS (The Text)
model Chapter {
  id        String   @id @default(uuid())
  title     String
  content   String   // Main text content
  order     Int      // To sort chapters (1, 2, 3...)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 🧠 LOREBOOK (The Memory: Characters, Locations)
model LorebookEntry {
  id          String   @id @default(uuid())
  name        String
  type        String   // "CHARACTER", "LOCATION", "EVENT", "ITEM"
  description String   // Detailed context for AI
  status      String?  // e.g. "Alive", "Destroyed", "Active"
  
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 🕸️ GRAPH (The Visual Plot)
model GraphNode {
  id        String  @id // ID from React Flow
  type      String  // "eventNode", "characterNode"
  positionX Float
  positionY Float
  data      String  // JSON stringified data (label, details)
  
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model GraphEdge {
  id        String  @id // ID from React Flow
  source    String  // Node ID
  target    String  // Node ID
  
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
